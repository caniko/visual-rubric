strict_env
use flake .
watch_file ../nix-opencode-lsp/lib/default.nix
# Keep the language-server refresh from deleting the project shell's cache.
direnv_layout_dir="$PWD/.direnv/opencode-lsp" use flake git+https://github.com/caniko/harbor-rs.git#opencode-lsp --override-input nix-opencode-lsp path:../nix-opencode-lsp
