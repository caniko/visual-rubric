strict_env
use flake .
# Keep the language-server refresh from deleting the project shell's cache.
if [[ -f ../nix-opencode-lsp/flake.nix ]]; then
  watch_file ../nix-opencode-lsp/lib/default.nix
  direnv_layout_dir="$PWD/.direnv/opencode-lsp" use flake 'git+https://github.com/caniko/harbor.git?ref=feat/harbor-monorepo-components&rev=e8b1996580e4ecd51dd402edf4a16d9df88e3a1b#rust-opencode-lsp' --override-input nix-opencode-lsp path:../nix-opencode-lsp
else
  direnv_layout_dir="$PWD/.direnv/opencode-lsp" use flake 'git+https://github.com/caniko/harbor.git?ref=feat/harbor-monorepo-components&rev=e8b1996580e4ecd51dd402edf4a16d9df88e3a1b#rust-opencode-lsp'
fi
